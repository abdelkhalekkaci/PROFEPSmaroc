        options: [
          "Inciter les jeunes à fuir l'initiative privée pour rechercher uniquement des emplois de rente.",
          "Développer la culture entrepreneuriale, l'éducation financière responsable (gestion de budget, épargne, investissement) et le sens de l'initiative et de l'innovation chez les futurs bacheliers.",
          "Interdire aux élèves toute réflexion sur la création d'entreprises au Maroc.",
          "Considérer que l'économie ne concerne que les banques et pas la vie quotidienne des citoyens."
        ],
        answer: 1,
        explanation: "L'enseignement de l'économie et de la gestion au Maroc vise à former des acteurs économiques autonomes et responsables : maîtrise de l'éducation financière (Fondation Marocaine pour l'Éducation Financière - FMEF), valorisation de l'esprit d'entreprise et compréhension des leviers de développement du Royaume.",
        reference: "Feuille de Route 2022-2026 & Rapport Général sur le Nouveau Modèle de Développement (NMD Maroc)"
      }
    ];

    let currentQuestionIdx = 0;
    let userAnswers = new Array(quizData.length).fill(null);
    let secondsElapsed = 0;
    let timerInterval = null;

    function startTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        secondsElapsed++;
        const mins = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
        const secs = String(secondsElapsed % 60).padStart(2, '0');
        const display = `${mins}:${secs}`;
        const el = document.getElementById('timer-display');
        if (el) el.textContent = display;
      }, 1000);
    }

    function renderQuestion(idx) {
      const q = quizData[idx];
      document.getElementById('question-counter').textContent = `Question ${idx + 1} / ${quizData.length}`;
      document.getElementById('category-badge').textContent = q.category;
      document.getElementById('question-text').textContent = q.question;

      const progressPct = ((idx + 1) / quizData.length) * 100;
      document.getElementById('progress-bar').style.width = `${progressPct}%`;

      const container = document.getElementById('choices-container');
      container.innerHTML = '';

      q.options.forEach((optText, optIdx) => {
        const isSelected = userAnswers[idx] === optIdx;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.onclick = () => selectOption(optIdx);
        btn.className = `w-full text-left p-4 rounded-xl border text-sm sm:text-base transition-all duration-200 flex items-start gap-3.5 ${
          isSelected
            ? 'bg-amber-950/80 border-amber-500 text-amber-100 ring-2 ring-amber-500/30 font-semibold'
            : 'bg-slate-900 border-slate-800 text-slate-300 hover:bg-slate-850 hover:border-slate-700'
        }`;

        const markerLetter = ['A', 'B', 'C', 'D'][optIdx];
        btn.innerHTML = `
          <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-xs font-black shrink-0 ${
            isSelected ? 'bg-amber-600 text-white shadow' : 'bg-slate-800 text-slate-400 border border-slate-700'
          }">${markerLetter}</span>
          <span class="leading-relaxed flex-1">${optText}</span>
        `;
        container.appendChild(btn);
      });

      document.getElementById('prev-btn').disabled = idx === 0;

      if (idx === quizData.length - 1) {
        document.getElementById('next-btn').classList.add('hidden');
        document.getElementById('submit-btn').classList.remove('hidden');
      } else {
        document.getElementById('next-btn').classList.remove('hidden');
        document.getElementById('submit-btn').classList.add('hidden');
      }
    }

    function selectOption(optIdx) {
      userAnswers[currentQuestionIdx] = optIdx;
      renderQuestion(currentQuestionIdx);
    }

    function nextQuestion() {
      if (currentQuestionIdx < quizData.length - 1) {
        currentQuestionIdx++;
        renderQuestion(currentQuestionIdx);
      }
    }

    function prevQuestion() {
      if (currentQuestionIdx > 0) {
        currentQuestionIdx--;
        renderQuestion(currentQuestionIdx);
      }
    }

    function finishQuiz() {
      clearInterval(timerInterval);

      let correctCount = 0;
      quizData.forEach((q, idx) => {
        if (userAnswers[idx] === q.answer) {
          correctCount++;
        }
      });

      const scoreOutOf20 = (correctCount / quizData.length) * 20;
      const accuracyPct = Math.round((correctCount / quizData.length) * 100);

      document.getElementById('quiz-container').classList.add('hidden');
      document.getElementById('result-container').classList.remove('hidden');

      document.getElementById('final-score').textContent = `${scoreOutOf20}/20`;
      document.getElementById('stat-correct').textContent = correctCount;
      document.getElementById('stat-wrong').textContent = quizData.length - correctCount;
      document.getElementById('stat-accuracy').textContent = `${accuracyPct}%`;

      const mins = String(Math.floor(secondsElapsed / 60)).padStart(2, '0');
      const secs = String(secondsElapsed % 60).padStart(2, '0');
      document.getElementById('stat-time').textContent = `${mins}:${secs}`;

      const badge = document.getElementById('score-badge');
      const title = document.getElementById('diagnostic-title');
      const desc = document.getElementById('diagnostic-desc');

      if (scoreOutOf20 >= 16) {
        badge.className = "inline-flex items-center justify-center w-24 h-24 rounded-full bg-emerald-950/80 border-4 border-emerald-500 text-3xl font-black text-emerald-300 mb-4 shadow-xl shadow-emerald-950/50";
        title.textContent = "Excellente Maîtrise Didactique · Très Honorable";
        desc.textContent = "Parfaite assimilation de l'ingénierie pédagogique en économie-gestion : transposition des savoirs, méthode des cas, décodage documentaire HCP et évaluation par compétences.";
      } else if (scoreOutOf20 >= 12) {
        badge.className = "inline-flex items-center justify-center w-24 h-24 rounded-full bg-amber-950/80 border-4 border-amber-500 text-3xl font-black text-amber-300 mb-4 shadow-xl shadow-amber-950/50";
        title.textContent = "Niveau Satisfaisant · Profil Admissible au Concours";
        desc.textContent = "Bonne maîtrise des principes didactiques généraux. Affinez la formalisation des situations-problèmes en comptabilité et les grilles de correction de la synthèse.";
      } else if (scoreOutOf20 >= 10) {
        badge.className = "inline-flex items-center justify-center w-24 h-24 rounded-full bg-yellow-950/80 border-4 border-yellow-500 text-3xl font-black text-yellow-300 mb-4 shadow-xl shadow-yellow-950/50";
        title.textContent = "Niveau Moyen · Seuil Minimal de Passage";
        desc.textContent = "Bases méthodologiques acquises mais confusions subsistantes. Revoir les Orientations Pédagogiques Officielles du Ministère pour le secondaire qualifiant.";
      } else {
        badge.className = "inline-flex items-center justify-center w-24 h-24 rounded-full bg-red-950/80 border-4 border-red-500 text-3xl font-black text-red-300 mb-4 shadow-xl shadow-red-950/50";
        title.textContent = "Niveau Insuffisant · Risque d'Élimination";
        desc.textContent = "Des lacunes importantes en didactique disciplinaire. Étudiez les guides pédagogiques officiels du MENPS et les annales de didactique du CRMEF.";
      }

      renderReviewList();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderReviewList() {
      const list = document.getElementById('review-list');
      list.innerHTML = '';

      quizData.forEach((q, idx) => {
        const userChoice = userAnswers[idx];
        const isCorrect = userChoice === q.answer;

        const card = document.createElement('div');
        card.className = `p-4 sm:p-5 rounded-xl border ${
          isCorrect ? 'bg-slate-900/80 border-emerald-800/60' : 'bg-slate-900/80 border-red-900/60'
        }`;

        const userOptionText = userChoice !== null ? q.options[userChoice] : 'Aucune réponse fournie';
        const correctOptionText = q.options[q.answer];

        card.innerHTML = `
          <div class="flex items-start justify-between gap-3 mb-2">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-xs font-bold ${
              isCorrect ? 'bg-emerald-950 text-emerald-300 border border-emerald-800' : 'bg-red-950 text-red-300 border border-red-800'
            }">
              <span>${isCorrect ? '✓ Réponse Didactique Exacte' : '✗ Erreur Méthodologique'}</span>
            </span>
            <span class="text-xs text-amber-400 font-semibold">${q.category} · Question ${idx + 1}</span>
          </div>
          
          <h5 class="text-sm sm:text-base font-bold text-slate-100 mb-3 leading-relaxed">${q.question}</h5>
          
          <div class="space-y-1.5 text-xs sm:text-sm mb-3">
            <div class="p-2.5 rounded-lg ${isCorrect ? 'bg-emerald-950/40 text-emerald-200' : 'bg-red-950/40 text-red-200'}">
              <span class="font-bold block text-xs opacity-75">Votre choix :</span>
              <span>${userOptionText}</span>
            </div>
            ${!isCorrect ? `
              <div class="p-2.5 rounded-lg bg-emerald-950/40 text-emerald-200 border border-emerald-800/40">
                <span class="font-bold block text-xs opacity-75">Réponse attendue :</span>
                <span>${correctOptionText}</span>
              </div>
            ` : ''}
          </div>

          <div class="p-3 rounded-lg bg-amber-950/30 border border-amber-900/40 text-xs sm:text-sm text-amber-200 leading-relaxed">
            <strong class="text-amber-300 block mb-1">💡 Analyse Didactique & Justification :</strong>
            ${q.explanation}
            <div class="mt-2 pt-2 border-t border-amber-900/30 text-xs text-slate-400 flex items-center gap-1">
              <span>📚 Référence officielle :</span>
              <span class="text-amber-300 font-medium">${q.reference}</span>
            </div>
          </div>
        `;
        list.appendChild(card);
      });
    }

    function restartQuiz() {
      currentQuestionIdx = 0;
      userAnswers = new Array(quizData.length).fill(null);
      secondsElapsed = 0;
      document.getElementById('result-container').classList.add('hidden');
      document.getElementById('quiz-container').classList.remove('hidden');
      startTimer();
      renderQuestion(0);
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    document.addEventListener('DOMContentLoaded', () => {
      startTimer();
      renderQuestion(0);
    });
  </script>

</body>
</html>
