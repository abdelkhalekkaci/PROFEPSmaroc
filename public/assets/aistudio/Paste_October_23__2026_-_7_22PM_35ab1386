  <script>
    const TOTAL_SERIES = 100;
    const QUESTIONS_PER_SERIES = 10;
    const ENGLISH_DIDACTIQUE_BANK = [
  {
    "id": "eng-did-01",
    "theme": "ELT Approaches & Methods",
    "reference": "Communicative Language Teaching (CLT) · Richards & Rodgers",
    "question": "What is the primary pedagogical goal of the Communicative Language Teaching (CLT) approach adopted in the Moroccan English curriculum?",
    "options": [
      {
        "id": "A",
        "text": "Mastering grammatical rules and error-free translation of classical texts.",
        "correct": false
      },
      {
        "id": "B",
        "text": "Developing learners' communicative competence (linguistic, sociolinguistic, discourse, and strategic) in authentic real-life situations.",
        "correct": true
      },
      {
        "id": "C",
        "text": "Memorizing bilingual vocabulary lists through repetition drills.",
        "correct": false
      },
      {
        "id": "D",
        "text": "Perfecting British accent and phonemic transcription without speaking.",
        "correct": false
      }
    ],
    "explanation": "CLT prioritizes 'communicative competence' (Hymes, Canale & Swain) over mere linguistic accuracy. The focus is on meaningful communication, authentic language use, and fluency in communicative interactions."
  },
  {
    "id": "eng-did-02",
    "theme": "Lesson Structuring Frameworks",
    "reference": "PPP vs. TBL Frameworks in Moroccan Secondary Guidelines",
    "question": "In the standard PPP lesson model (Presentation, Practice, Production), what distinguishes the 'Production' phase from the 'Practice' phase?",
    "options": [
      {
        "id": "A",
        "text": "In Production, learners only copy sentences written on the board.",
        "correct": false
      },
      {
        "id": "B",
        "text": "Practice is controlled and focuses on accuracy, while Production is freer and encourages fluency and authentic communicative use of the target language.",
        "correct": true
      },
      {
        "id": "C",
        "text": "Production is conducted exclusively by the teacher while students listen.",
        "correct": false
      },
      {
        "id": "D",
        "text": "Practice requires translation, while Production requires silence.",
        "correct": false
      }
    ],
    "explanation": "In PPP, the Practice stage involves controlled exercises (fill-in-the-blanks, drills) focusing on accuracy, whereas the Production stage allows students to use the newly acquired structure freely in creative tasks (role-plays, debates, writing) to foster fluency."
  },
  {
    "id": "eng-did-03",
    "theme": "Teaching Receptive Skills",
    "reference": "Reading Strategies · Jeremy Harmer / Scrivener",
    "question": "What is the difference between 'Skimming' and 'Scanning' in reading comprehension methodology?",
    "options": [
      {
        "id": "A",
        "text": "Skimming is reading aloud; scanning is reading silently.",
        "correct": false
      },
      {
        "id": "B",
        "text": "Skimming is reading rapidly for the main idea / gist, while scanning is reading quickly to locate specific pieces of information (names, dates, figures).",
        "correct": true
      },
      {
        "id": "C",
        "text": "Scanning translates word-for-word, while skimming ignores paragraphs.",
        "correct": false
      },
      {
        "id": "D",
        "text": "Both terms mean reading every word with a dictionary.",
        "correct": false
      }
    ],
    "explanation": "Skimming involves fast reading to get the overall gist or central theme of a text. Scanning involves searching the text rapidly to spot specific isolated details or keywords without reading the entire text."
  },
  {
    "id": "eng-did-04",
    "theme": "Teaching Productive Skills",
    "reference": "Process Approach to Writing in ELT",
    "question": "What are the sequential pedagogical stages of the 'Process Writing' approach recommended in Moroccan high schools?",
    "options": [
      {
        "id": "A",
        "text": "Grading, punishing, publishing, and archiving.",
        "correct": false
      },
      {
        "id": "B",
        "text": "Pre-writing (Brainstorming/Outlining) -> Drafting -> Revising (Content & Organization) -> Editing (Proofreading for Mechanics) -> Publishing.",
        "correct": true
      },
      {
        "id": "C",
        "text": "Copying a model paragraph from the textbook directly into the exam sheet.",
        "correct": false
      },
      {
        "id": "D",
        "text": "Writing once without reviewing, then immediate submission.",
        "correct": false
      }
    ],
    "explanation": "Process writing views writing as a recursive cognitive process rather than a one-shot product. Students generate ideas (pre-writing), draft initial thoughts, revise ideas and coherence, edit for grammatical/spelling accuracy, and share their final work."
  },
  {
    "id": "eng-did-05",
    "theme": "Grammar Instruction",
    "reference": "Inductive vs. Deductive Grammar Teaching · Thornbury",
    "question": "What happens during an 'Inductive' approach to teaching English grammar (Guided Discovery)?",
    "options": [
      {
        "id": "A",
        "text": "The teacher states the rule explicitly and gives practice exercises immediately.",
        "correct": false
      },
      {
        "id": "B",
        "text": "Learners analyze authentic language examples in context and discover the underlying grammatical rule for themselves with teacher guidance.",
        "correct": true
      },
      {
        "id": "C",
        "text": "Grammar is completely ignored and forbidden in class.",
        "correct": false
      },
      {
        "id": "D",
        "text": "Students memorize grammatical tables from Latin grammar books.",
        "correct": false
      }
    ],
    "explanation": "An inductive approach (guided discovery) provides context and examples first, prompting students to notice patterns and formulate the rule collaboratively, leading to deeper cognitive engagement and retention compared to deductive rule-first lecturing."
  },
  {
    "id": "eng-did-06",
    "theme": "Error Correction & Feedback",
    "reference": "Formative Feedback in ELT · Ur & Scrivener",
    "question": "During a free communicative speaking activity aiming at fluency, when and how should the teacher provide error correction?",
    "options": [
      {
        "id": "A",
        "text": "Interrupt the speaker immediately after every single grammatical mistake.",
        "correct": false
      },
      {
        "id": "B",
        "text": "Withhold immediate interruption to maintain fluency; take notes of common errors and provide delayed, constructive whole-class feedback afterwards.",
        "correct": true
      },
      {
        "id": "C",
        "text": "Never provide any feedback or correction under any circumstances.",
        "correct": false
      },
      {
        "id": "D",
        "text": "Assign a failing grade on the spot to discourage mistakes.",
        "correct": false
      }
    ],
    "explanation": "Interrupting during fluency tasks shatters confidence and communicative flow. Good practice dictates taking discreet notes of recurrent errors and conducting a delayed 'error clinic' / anonymous feedback session at the end of the activity."
  },
  {
    "id": "eng-did-07",
    "theme": "Classroom Management",
    "reference": "Teacher Roles and Group Work in TEFL",
    "question": "What is the primary role of the EFL teacher during pair-work or small group communicative tasks?",
    "options": [
      {
        "id": "A",
        "text": "Authoritarian controller delivering continuous lectures from the front desk.",
        "correct": false
      },
      {
        "id": "B",
        "text": "Facilitator, monitor, and resource person who circulates unobtrusively, assists when needed, and ensures task engagement.",
        "correct": true
      },
      {
        "id": "C",
        "text": "Grading papers silently without observing the students.",
        "correct": false
      },
      {
        "id": "D",
        "text": "Leaving the classroom until the activity ends.",
        "correct": false
      }
    ],
    "explanation": "In CLT classrooms, the teacher shifts from the 'sage on the stage' to a facilitator and monitor, managing the learning environment, guiding interactions, and gathering formative assessment data."
  },
  {
    "id": "eng-did-08",
    "theme": "Task-Based Language Teaching (TBLT)",
    "reference": "Task-Based Learning Framework · Jane Willis",
    "question": "According to Jane Willis, what are the three essential stages of a Task-Based Learning (TBL) framework?",
    "options": [
      {
        "id": "A",
        "text": "Introduction, Interrogation, and Punitive Testing.",
        "correct": false
      },
      {
        "id": "B",
        "text": "Pre-task (Introduction to topic and task) -> Task Cycle (Task, Planning, Report) -> Language Focus (Analysis and Practice).",
        "correct": true
      },
      {
        "id": "C",
        "text": "Translation, Memorization, and Dictation.",
        "correct": false
      },
      {
        "id": "D",
        "text": "Silent reading, Homework assignment, and Bell ring.",
        "correct": false
      }
    ],
    "explanation": "Willis's TBL framework consists of: 1) Pre-task (setting the scene and activating schema); 2) Task Cycle (carrying out the task in pairs/groups, planning report, and presenting findings); 3) Language Focus (analyzing and practicing language forms that emerged during the task)."
  },
  {
    "id": "eng-did-09",
    "theme": "Assessment & Evaluation in ELT",
    "reference": "Continuous Assessment & Moroccan Baccalaureate Specifications",
    "question": "What is the distinction between 'Formative Assessment' and 'Summative Assessment'?",
    "options": [
      {
        "id": "A",
        "text": "Formative is oral; summative is always written.",
        "correct": false
      },
      {
        "id": "B",
        "text": "Formative assessment is ongoing during learning to provide feedback and guide instruction, while summative assessment evaluates cumulative achievement at the end of an instructional unit (e.g., National Exam).",
        "correct": true
      },
      {
        "id": "C",
        "text": "Formative is graded out of 100; summative is graded out of 10.",
        "correct": false
      },
      {
        "id": "D",
        "text": "Summative assessment happens before the lesson starts.",
        "correct": false
