    let currentSeriesNumber = 1;
    let currentSeries = [];
    let userAnswers = {};
    let isSubmitted = false;
    let score = 0;

    function getSeriesQuestions(seriesNum) {
      const bankSize = EPS_SPECIALITE_BANK.length;
      const selected = [];
      const offset = (seriesNum - 1) * 3;
      const stride = 7;

      for (let i = 0; i < QUESTIONS_PER_SERIES; i++) {
        const index = (offset + i * stride + Math.floor((seriesNum * 11) / bankSize)) % bankSize;
        let q = EPS_SPECIALITE_BANK[index];
        let step = 1;
        while (selected.some(existing => existing.id === q.id)) {
          q = EPS_SPECIALITE_BANK[(index + step) % bankSize];
          step++;
        }
        selected.push(q);
      }
      return selected;
    }

    function initSeriesSelector() {
      const dropdown = document.getElementById('series-dropdown-selector');
      dropdown.innerHTML = '';
      for (let s = 1; s <= TOTAL_SERIES; s++) {
        const opt = document.createElement('option');
        opt.value = s;
        opt.textContent = `Série ${s} / ${TOTAL_SERIES}`;
        dropdown.appendChild(opt);
      }

      const pillsContainer = document.getElementById('quick-series-pills');
      pillsContainer.innerHTML = '';
      for (let s = 1; s <= 10; s++) {
        const btn = document.createElement('button');
        btn.id = `pill-series-${s}`;
        btn.textContent = `S${s}`;
        btn.onclick = () => loadSeries(s);
        btn.className = `px-3 py-1 rounded-lg text-xs font-bold transition-all shrink-0 cursor-pointer ${s === 1 ? 'bg-teal-800 text-white shadow-xs' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}`;
        pillsContainer.appendChild(btn);
      }
    }

    function loadSeries(seriesNum) {
      currentSeriesNumber = seriesNum;
      userAnswers = {};
      isSubmitted = false;
      score = 0;

      document.getElementById('current-series-display').textContent = `Série ${seriesNum} / ${TOTAL_SERIES}`;
      document.getElementById('series-dropdown-selector').value = seriesNum;

      for (let s = 1; s <= 10; s++) {
        const p = document.getElementById(`pill-series-${s}`);
        if (p) {
          if (s === seriesNum) {
            p.className = 'px-3 py-1 rounded-lg text-xs font-bold bg-teal-800 text-white shadow-xs shrink-0 cursor-pointer transition-all';
          } else {
            p.className = 'px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 shrink-0 cursor-pointer transition-all';
          }
        }
      }

      currentSeries = getSeriesQuestions(seriesNum);
      renderQuizQuestions();

      document.getElementById('results-block').classList.add('hidden');
      document.getElementById('submit-series-block').classList.remove('hidden');
      updateProgressDisplay();
      window.scrollTo({ top: 220, behavior: 'smooth' });
    }

    function loadRandomSeries() {
      const rand = Math.floor(Math.random() * TOTAL_SERIES) + 1;
      loadSeries(rand);
    }

    function loadNextSeries() {
      const next = (currentSeriesNumber % TOTAL_SERIES) + 1;
      loadSeries(next);
    }

    function resetCurrentSeries() {
      loadSeries(currentSeriesNumber);
    }

    function renderQuizQuestions() {
      const container = document.getElementById('quiz-questions-container');
      container.innerHTML = '';

      currentSeries.forEach((q, idx) => {
        const qCard = document.createElement('div');
        qCard.id = `quiz-card-${q.id}`;
        qCard.className = 'p-5 sm:p-6 rounded-3xl bg-white border border-slate-200 shadow-xs space-y-4 transition-all text-left';

        const isAnswered = !!userAnswers[q.id];

        qCard.innerHTML = `
          <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-3">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-1 rounded-lg bg-teal-100 text-teal-900 font-black text-xs">
                Question ${idx + 1} / 10
              </span>
              <span class="text-xs font-bold text-slate-500">
                ${q.theme}
              </span>
            </div>
            <span id="status-badge-${q.id}" class="text-[11px] font-bold px-2 py-0.5 rounded-md ${isAnswered ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-slate-100 text-slate-500'}">
              ${isAnswered ? ('✓ تم الاختيار' if dir_attr == 'rtl' else '✓ Répondu') : ('في الانتظار' if dir_attr == 'rtl' else 'En attente')}
            </span>
          </div>

          <div class="space-y-1.5">
            <h3 class="text-sm sm:text-base font-extrabold text-slate-900 leading-snug">
              ${q.question}
            </h3>
          </div>

          <div class="space-y-2 pt-1" id="options-group-${q.id}">
            ${q.options.map(opt => {
              const isSelected = userAnswers[q.id] === opt.id;
              return `
                <button type="button" onclick="selectOption('${q.id}', '${opt.id}')"
                  class="w-full text-left p-3.5 rounded-xl border text-xs sm:text-sm font-semibold transition-all cursor-pointer flex items-start gap-3 ${isSelected ? 'border-slate-800 bg-slate-100 text-slate-950 shadow-xs ring-1 ring-slate-800' : 'border-slate-200 hover:border-slate-300 bg-white text-slate-700 hover:bg-slate-50/60'}">
                  <span class="w-6 h-6 rounded-lg flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 ${isSelected ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 border border-slate-200'}">
                    ${opt.id}
                  </span>
                  <span class="flex-1 leading-relaxed">${opt.text}</span>
                </button>
              `;
            }).join('')}
          </div>
        `;
        container.appendChild(qCard);
      });
    }

    function selectOption(questionId, optionId) {
      if (isSubmitted) return;
      userAnswers[questionId] = optionId;

      const q = currentSeries.find(item => item.id === questionId);
      if (q) {
        const optionsGroup = document.getElementById(`options-group-${questionId}`);
        if (optionsGroup) {
          optionsGroup.innerHTML = q.options.map(opt => {
            const isSelected = userAnswers[questionId] === opt.id;
            return `
              <button type="button" onclick="selectOption('${q.id}', '${opt.id}')"
                class="w-full text-left p-3.5 rounded-xl border text-xs sm:text-sm font-semibold transition-all cursor-pointer flex items-start gap-3 ${isSelected ? 'border-slate-800 bg-slate-100 text-slate-950 shadow-xs ring-1 ring-slate-800' : 'border-slate-200 hover:border-slate-300 bg-white text-slate-700 hover:bg-slate-50/60'}">
                <span class="w-6 h-6 rounded-lg flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 ${isSelected ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 border border-slate-200'}">
                  ${opt.id}
                </span>
                <span class="flex-1 leading-relaxed">${opt.text}</span>
              </button>
            `;
          }).join('');
        }
      }

      const badge = document.getElementById(`status-badge-${questionId}`);
      if (badge) {
        badge.className = 'text-[11px] font-bold px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200';
        badge.textContent = "✓ Répondu";
      }

      updateProgressDisplay();
    }

    function updateProgressDisplay() {
      const answeredCount = Object.keys(userAnswers).length;
      document.getElementById('progress-summary').textContent = `Progression : ${answeredCount} / ${currentSeries.length}`;
    }

    function submitCurrentSeries() {
      const answeredCount = Object.keys(userAnswers).length;
      if (answeredCount < currentSeries.length) {
        const confirmSubmit = confirm(`Vous avez répondu à ${answeredCount} / ${currentSeries.length} questions. Voulez-vous terminer et voir la correction ?`);
        if (!confirmSubmit) return;
      }

      isSubmitted = true;
      document.getElementById('submit-series-block').classList.add('hidden');
      document.getElementById('results-block').classList.remove('hidden');
      document.getElementById('btn-next-series-num').textContent = (currentSeriesNumber % TOTAL_SERIES) + 1;

      score = 0;
      currentSeries.forEach(q => {
        const correctOpt = q.options.find(o => o.correct);
        if (correctOpt && userAnswers[q.id] === correctOpt.id) {
          score++;
        }
      });

      document.getElementById('final-score').textContent = score;
      const note20 = (score * 2).toFixed(1);
      document.getElementById('final-note-20').textContent = note20;
      const pct = Math.round((score / currentSeries.length) * 100);
      document.getElementById('final-percentage').textContent = `${pct}%`;

      const diagBox = document.getElementById('results-diagnosis-box');
      if (score >= 8) {
        diagBox.className = 'max-w-md mx-auto p-4 rounded-2xl border border-emerald-300 bg-emerald-50 text-emerald-900 text-xs font-bold space-y-1 text-left';
        diagBox.innerHTML = `<div>🏆 Excellent niveau de maîtrise (Niveau Admissible).</div>`;
      } else if (score >= 5) {
        diagBox.className = 'max-w-md mx-auto p-4 rounded-2xl border border-amber-300 bg-amber-50 text-amber-900 text-xs font-bold space-y-1 text-left';
        diagBox.innerHTML = `<div>⚖️ Niveau moyen avec points de remédiation nécessaires.</div>`;
      } else {
        diagBox.className = 'max-w-md mx-auto p-4 rounded-2xl border border-rose-300 bg-rose-50 text-rose-900 text-xs font-bold space-y-1 text-left';
        diagBox.innerHTML = `<div>⚠️ Révision indispensable des fondamentaux et des cadres de référence.</div>`;
      }

      renderCorrectionItems();
      document.getElementById('results-block').scrollIntoView({ behavior: 'smooth' });
    }

    function renderCorrectionItems() {
      const container = document.getElementById('correction-items-container');
      container.innerHTML = '';

      currentSeries.forEach((q, idx) => {
        const correctOpt = q.options.find(o => o.correct);
        const userChoice = userAnswers[q.id];
        const isCorrect = userChoice && correctOpt && userChoice === correctOpt.id;

        const card = document.createElement('div');
        card.className = `p-5 sm:p-6 rounded-3xl border transition-all ${isCorrect ? 'bg-white border-emerald-200 shadow-xs' : 'bg-white border-rose-200 shadow-xs'} text-left`;

        card.innerHTML = `
          <div class="flex items-center justify-between gap-2 border-b pb-3 ${isCorrect ? 'border-emerald-100' : 'border-rose-100'}">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full flex items-center justify-center font-black text-xs ${isCorrect ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">
                ${isCorrect ? '✓' : '✗'}
              </span>
              <span class="font-extrabold text-xs sm:text-sm text-slate-800">
                Question ${idx + 1} : ${q.theme}
              </span>
            </div>
            <span class="text-[11px] font-bold px-2.5 py-1 rounded-lg ${isCorrect ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-rose-50 text-rose-800 border border-rose-200'}">
              ${isCorrect ? '+1 pt' : '0 pt'}
            </span>
          </div>

          <div class="py-3 space-y-2">
            <h4 class="text-sm sm:text-base font-extrabold text-slate-900 leading-snug">
              ${q.question}
            </h4>
          </div>

          <div class="space-y-2 py-2">
            ${q.options.map(opt => {
              let optStyle = 'border-slate-200 bg-slate-50/50 text-slate-600 opacity-70';
              let badge = `<span class="w-6 h-6 rounded-lg bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-xs">${opt.id}</span>`;

              if (opt.correct) {
                optStyle = 'border-emerald-500 bg-emerald-50/90 text-emerald-950 font-bold shadow-xs ring-1 ring-emerald-500';
                badge = `<span class="w-6 h-6 rounded-lg bg-emerald-700 text-white flex items-center justify-center font-bold text-xs">✓ ${opt.id}</span>`;
              } else if (userChoice === opt.id && !opt.correct) {
                optStyle = 'border-rose-500 bg-rose-50/90 text-rose-950 font-bold shadow-xs ring-1 ring-rose-500';
                badge = `<span class="w-6 h-6 rounded-lg bg-rose-600 text-white flex items-center justify-center font-bold text-xs">✗ ${opt.id}</span>`;
              }

              return `
                <div class="p-3 rounded-xl border text-xs sm:text-sm flex items-start gap-3 ${optStyle}">
                  ${badge}
                  <span class="flex-1 leading-relaxed">${opt.text}</span>
                </div>
              `;
            }).join('')}
          </div>

          <div class="mt-3 p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-700 space-y-1.5">
            <div class="font-bold text-slate-900">💡 Justification & Référence Officielle :</div>
            <p class="leading-relaxed font-normal">${q.explanation}</p>
            <div class="text-[11px] text-slate-500 pt-1 border-t border-slate-200 font-semibold">
              Réf : ${q.reference}
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function switchMode(mode) {
      const seriesView = document.getElementById('view-mode-series');
      const bankView = document.getElementById('view-mode-bank');
      const tabSeries = document.getElementById('tab-mode-series');
      const tabBank = document.getElementById('tab-mode-bank');

      if (mode === 'series') {
        seriesView.classList.remove('hidden');
        bankView.classList.add('hidden');
        tabSeries.className = 'px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm bg-teal-800 text-white shadow-md transition-all flex items-center gap-2 cursor-pointer';
        tabBank.className = 'px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-all flex items-center gap-2 cursor-pointer';
      } else {
        seriesView.classList.add('hidden');
        bankView.classList.remove('hidden');
        tabBank.className = 'px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm bg-teal-800 text-white shadow-md transition-all flex items-center gap-2 cursor-pointer';
        tabSeries.className = 'px-5 py-2.5 rounded-xl font-bold text-xs sm:text-sm bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-all flex items-center gap-2 cursor-pointer';
        initBankView();
      }
    }

    function initBankView() {
      const select = document.getElementById('bank-filter-theme');
      const themes = [...new Set(EPS_SPECIALITE_BANK.map(q => q.theme))];
      select.innerHTML = '<option value="ALL">Tous les thèmes (40 questions)</option>';
      themes.forEach(th => {
        const opt = document.createElement('option');
        opt.value = th;
        opt.textContent = th;
        select.appendChild(opt);
      });
      filterBankQuestions();
    }

    function filterBankQuestions() {
      const themeFilter = document.getElementById('bank-filter-theme').value;
      const searchTxt = document.getElementById('bank-search-input').value.trim().toLowerCase();
      const container = document.getElementById('bank-questions-container');
      container.innerHTML = '';

      const filtered = EPS_SPECIALITE_BANK.filter(q => {
        const matchTheme = (themeFilter === 'ALL' || q.theme === themeFilter);
        const matchSearch = !searchTxt || 
          q.question.toLowerCase().includes(searchTxt) ||
          q.explanation.toLowerCase().includes(searchTxt) ||
          q.reference.toLowerCase().includes(searchTxt);
        return matchTheme && matchSearch;
      });

      if (filtered.length === 0) {
        container.innerHTML = `<div class="p-8 text-center bg-white rounded-3xl border border-slate-200 text-slate-500 text-sm">Aucune question ne correspond à votre recherche.</div>`;
        return;
      }

      filtered.forEach((q, idx) => {
        const card = document.createElement('div');
        card.className = 'p-5 sm:p-6 rounded-3xl bg-white border border-slate-200 shadow-xs space-y-4 text-left';
        card.innerHTML = `
          <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-3">
            <span class="px-2.5 py-1 rounded-lg bg-teal-100 text-teal-900 font-black text-xs">
              Q${idx + 1} / ${filtered.length}
            </span>
            <span class="text-xs font-bold text-slate-500">${q.theme}</span>
          </div>
          <h3 class="text-sm sm:text-base font-extrabold text-slate-900 leading-snug">${q.question}</h3>
          <div class="space-y-2 pt-1">
            ${q.options.map(opt => `
              <div class="p-3 rounded-xl border text-xs sm:text-sm flex items-start gap-3 ${opt.correct ? 'border-emerald-500 bg-emerald-50 text-emerald-950 font-bold' : 'border-slate-200 bg-slate-50 text-slate-700'}">
                <span class="w-6 h-6 rounded-lg flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 ${opt.correct ? 'bg-emerald-700 text-white' : 'bg-slate-200 text-slate-600'}">
                  ${opt.id}
                </span>
                <span class="flex-1 leading-relaxed">${opt.text}</span>
                ${opt.correct ? '<span class="text-[11px] text-emerald-700 font-black self-center">✓ Correct</span>' : ''}
              </div>
            `).join('')}
          </div>
          <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-700 space-y-1">
            <div class="font-bold text-slate-900">Justification :</div>
            <p class="leading-relaxed font-normal">${q.explanation}</p>
            <div class="text-[11px] text-slate-500 pt-1 font-semibold">Réf : ${q.reference}</div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    document.addEventListener('DOMContentLoaded', () => {
      initSeriesSelector();
      loadSeries(1);
    });
  </script>
</body>
</html>
