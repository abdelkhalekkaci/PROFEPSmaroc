rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'kaci.abdelkhalek.95@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // SHA-256 hash of server admin moderation key ('profeps-admin-mod-2026-verified')
    function isServerModAuthorized(data) {
      return 'modKeyHash' in data &&
        data.modKeyHash is string &&
        data.modKeyHash.size() == 64 &&
        data.modKeyHash == '7e8b1a9f2d4c6e0a3b5f8d2c1e9a7b4d6f0c2e8a1b3d5f7e9c0a2b4d6e8f1a3c';
    }

    function isValidTestimonial(data) {
      return data.keys().hasAll([
          'name', 'rating', 'comment', 'profession', 'city',
          'source', 'status', 'reportsCount', 'ipHash', 'createdAtIso'
        ]) &&
        data.keys().hasOnly([
          'name', 'rating', 'comment', 'profession', 'city',
          'source', 'status', 'reportsCount', 'ipHash', 'createdAtIso', 'modKeyHash'
        ]) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 10 && data.comment.size() <= 800 &&
        data.profession is string && data.profession.size() <= 80 &&
        data.city is string && data.city.size() <= 80 &&
        data.source is string && (data.source == 'homepage' || data.source == 'download_popup') &&
        data.status is string && (data.status == 'published' || data.status == 'hidden') &&
        data.reportsCount is int && data.reportsCount >= 0 && data.reportsCount <= 1000 &&
        data.ipHash is string && data.ipHash.size() == 64 && data.ipHash.matches('^[a-f0-9]{64}$') &&
        data.createdAtIso is string && data.createdAtIso.size() >= 10 && data.createdAtIso.size() <= 40 &&
        (!('modKeyHash' in data) || (data.modKeyHash is string && data.modKeyHash.size() <= 64));
    }

    function isValidArticleComment(data) {
      return data.keys().hasAll([
          'articleSlug', 'name', 'comment', 'profession', 'city',
          'status', 'reportsCount', 'ipHash', 'createdAtIso'
        ]) &&
        data.keys().hasOnly([
          'articleSlug', 'name', 'comment', 'profession', 'city',
          'status', 'reportsCount', 'ipHash', 'createdAtIso', 'modKeyHash'
        ]) &&
        data.articleSlug is string && data.articleSlug.size() >= 5 && data.articleSlug.size() <= 160 && data.articleSlug.matches('^[a-zA-Z0-9_\\-\\.]+$') &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 60 &&
        data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 800 &&
        data.profession is string && data.profession.size() <= 80 &&
        data.city is string && data.city.size() <= 80 &&
        data.status is string && (data.status == 'published' || data.status == 'hidden') &&
        data.reportsCount is int && data.reportsCount >= 0 && data.reportsCount <= 1000 &&
        data.ipHash is string && data.ipHash.size() == 64 && data.ipHash.matches('^[a-f0-9]{64}$') &&
        data.createdAtIso is string && data.createdAtIso.size() >= 10 && data.createdAtIso.size() <= 40 &&
        (!('modKeyHash' in data) || (data.modKeyHash is string && data.modKeyHash.size() <= 64));
    }

    // 3. Admins Collection
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if false;
      allow create, update, delete: if false;
    }

    // 4. Testimonials Collection
    match /testimonials/{testimonialId} {
      allow get: if isValidId(testimonialId) && (existing().status == 'published' || isAdmin());
      allow list: if existing().status == 'published' || isAdmin();

      allow create: if isValidId(testimonialId) &&
        isValidTestimonial(incoming()) &&
        incoming().status == 'published' &&
        incoming().reportsCount == 0;

      allow update: if isValidId(testimonialId) &&
        isValidTestimonial(incoming()) &&
        existing().status == 'published' &&
        incoming().name == existing().name &&
        incoming().rating == existing().rating &&
        incoming().comment == existing().comment &&
        incoming().profession == existing().profession &&
        incoming().city == existing().city &&
        incoming().source == existing().source &&
        incoming().ipHash == existing().ipHash &&
        incoming().createdAtIso == existing().createdAtIso && (
          isAdmin() ||
          // Action 1: Community Report (+1 increment, auto-hide at >= 2 reports)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['reportsCount', 'status']) &&
            incoming().reportsCount == existing().reportsCount + 1 &&
            incoming().status == (incoming().reportsCount >= 2 ? 'hidden' : 'published')
          ) ||
          // Action 2: Verified Server Admin Moderation Hide
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'modKeyHash']) &&
            incoming().status == 'hidden' &&
            isServerModAuthorized(incoming())
          )
        );

      allow delete: if isValidId(testimonialId) && isAdmin();
    }

    // 5. Article Comments Collection
    match /article_comments/{commentId} {
      allow get: if isValidId(commentId) && (existing().status == 'published' || isAdmin());
      allow list: if existing().status == 'published' || isAdmin();

      allow create: if isValidId(commentId) &&
        isValidArticleComment(incoming()) &&
        incoming().status == 'published' &&
        incoming().reportsCount == 0;

      allow update: if isValidId(commentId) &&
        isValidArticleComment(incoming()) &&
        existing().status == 'published' &&
        incoming().articleSlug == existing().articleSlug &&
        incoming().name == existing().name &&
        incoming().comment == existing().comment &&
        incoming().profession == existing().profession &&
        incoming().city == existing().city &&
        incoming().ipHash == existing().ipHash &&
        incoming().createdAtIso == existing().createdAtIso && (
          isAdmin() ||
          // Action 1: Community Report (+1 increment, auto-hide at >= 2 reports)
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['reportsCount', 'status']) &&
            incoming().reportsCount == existing().reportsCount + 1 &&
            incoming().status == (incoming().reportsCount >= 2 ? 'hidden' : 'published')
          ) ||
          // Action 2: Verified Server Admin Moderation Hide
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'modKeyHash']) &&
            incoming().status == 'hidden' &&
            isServerModAuthorized(incoming())
          )
        );

      allow delete: if isValidId(commentId) && isAdmin();
    }
  }
}
