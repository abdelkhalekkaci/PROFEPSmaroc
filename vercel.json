{
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "server.js" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.profeps.ma"
        }
      ],
      "destination": "https://profeps.ma/$1",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/article-bareme-eps-bac-maroc.html",
      "destination": "/qa-coefficient-eps-bac-maroc.html",
      "permanent": true
    }
  ]
}
