{
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "server.js" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "vmacalculateur.com"
        }
      ],
      "destination": "https://profeps.ma/calculateur-vma.html",
      "permanent": true
    },
